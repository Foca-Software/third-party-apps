<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================= -->
        <!-- Configuración general -->
        <!-- ========================= -->

        <!-- Nombre del sistema / aplicación -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_system_name', 'odooApp15')"/>

        <!-- ========================= -->
        <!-- Opciones de visibilidad -->
        <!-- ========================= -->

        <!-- Mostrar selector de idioma -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_lang', 'True')"/>

        <!-- Mostrar modo debug -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_debug', 'True')"/>

        <!-- Mostrar sección de documentación -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_documentation', 'True')"/>

        <!-- Mostrar documentación para desarrolladores -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_documentation_dev', 'True')"/>

        <!-- Mostrar enlace de soporte -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_support', 'True')"/>

        <!-- Mostrar acceso a cuenta online -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_account', 'True')"/>

        <!-- Mostrar branding Enterprise -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_enterprise', 'False')"/>

        <!-- Mostrar opción de compartir -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_share', 'False')"/>

        <!-- Mostrar texto "Powered by" -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_show_poweredby', 'False')"/>

        <!-- ========================= -->
        <!-- URLs externas -->
        <!-- ========================= -->

        <!-- Documentación de usuario -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_documentation_url', 'https://www.sunpop.cn/documentation/user/15.0/zh_CN/index.html')"/>

        <!-- Documentación para desarrolladores -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_documentation_dev_url', 'https://www.sunpop.cn/documentation/15.0/index.html')"/>

        <!-- Soporte técnico -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_support_url', 'https://www.sunpop.cn/trial')"/>

        <!-- ========================= -->
        <!-- Cuenta del usuario -->
        <!-- ========================= -->

        <!-- Título del acceso a la cuenta -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_account_title', 'My Online Account')"/>

        <!-- URL de la cuenta online -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_account_url', 'https://www.sunpop.cn/my-account')"/>

        <!-- ========================= -->
        <!-- Ribbon / Branding -->
        <!-- ========================= -->

        <!-- Texto del ribbon -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_ribbon_name', 'Sunpop.cn')"/>

        <!-- Color del texto del ribbon -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_ribbon_color', '#f0f0f0')"/>

        <!-- Color de fondo del ribbon -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('app_ribbon_background_color', 'rgba(255, 0, 0, 0.4)')"/>

    </data>
</odoo>
